// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION (NextAuth.js compatible)
// ============================================

enum UserRole {
  ADMIN
  PRO
  FREE_TRIAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Subscription & Role
  role              UserRole  @default(FREE_TRIAL)
  trialEndsAt       DateTime?
  subscriptionEndsAt DateTime?
  stripeCustomerId  String?   @unique
  stripeSubscriptionId String? @unique

  // User Preferences
  preferredCurrency String    @default("EUR") // User's preferred currency for viewing stats

  // Onboarding
  onboardingCompleted Boolean   @default(false)
  onboardingStep      Int       @default(0)

  // Professional Info
  jobTitle          String?
  bio               String?
  defaultHourlyRate Float?

  // Contact Information
  phone             String?
  website           String?
  linkedinUrl       String?
  twitterUrl        String?

  // Location
  address           String?
  city              String?
  country           String?
  timezone          String?   @default("UTC")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  workspaceMembers WorkspaceMember[]
  timeEntries      TimeEntry[]
  createdInvoices  Invoice[]         @relation("InvoiceCreator")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// WORKSPACE & TEAM MANAGEMENT
// ============================================

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         WorkspaceMember[]
  clients         Client[]
  projects        Project[]
  tasks           Task[]
  timeEntries     TimeEntry[]
  invoices        Invoice[]
  companySettings CompanySettings?

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  hourlyRate  Float?        // Default hourly rate for this user in this workspace
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================
// CLIENT MANAGEMENT
// ============================================

enum ClientStatus {
  LEAD          // Initial contact, not yet qualified
  PROSPECT      // Qualified lead, in discussion
  ACTIVE        // Current client with ongoing work
  INACTIVE      // Past client, no current work
  LOST          // Opportunity lost, not converted
}

enum LeadSource {
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  COLD_OUTREACH
  NETWORKING
  ADVERTISEMENT
  OTHER
}

model Client {
  id               String       @id @default(cuid())
  workspaceId      String

  // Basic Information
  name             String
  email            String?
  phone            String?
  company          String?
  website          String?

  // Address Information
  address          String?
  city             String?
  state            String?
  zipCode          String?
  country          String?

  // Business Information
  industry         String?
  companySize      String?

  // Relationship Tracking
  status           ClientStatus @default(LEAD)
  leadSource       LeadSource?
  referredBy       String?      // Name of person who referred
  firstContactDate DateTime?
  lastContactDate  DateTime?

  // Social & Communication
  linkedin         String?
  twitter          String?

  // Notes & Tags
  notes            String?
  tags             String?      // Comma-separated tags

  // Metadata
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  invoices  Invoice[]

  @@index([workspaceId])
  @@index([status])
  @@map("clients")
}

// ============================================
// PROJECT MANAGEMENT
// ============================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum BillingType {
  HOURLY
  FIXED_FEE
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  billingType BillingType   @default(HOURLY)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  hourlyRate  Float? // For hourly billing projects
  fixedPrice  Float? // For fixed-fee projects
  color       String? // For visual identification
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks        Task[]
  timeEntries  TimeEntry[]
  invoiceItems InvoiceItem[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

// ============================================
// TASK MANAGEMENT
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  estimatedHours Float?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries  TimeEntry[]
  invoiceItems InvoiceItem[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

// ============================================
// TIME TRACKING
// ============================================

model TimeEntry {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  projectId       String?
  taskId          String?
  description     String?
  startTime       DateTime
  endTime         DateTime?
  duration        Int? // Duration in seconds (calculated when stopped)
  hourlyRate      Float // Snapshot of hourly rate at time of entry
  billable        Boolean   @default(true)
  invoiced        Boolean   @default(false)
  invoiceItemId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([startTime])
  @@index([endTime])
  @@index([invoiced, billable, endTime])
  @@map("time_entries")
}

// ============================================
// INVOICING
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  workspaceId     String
  clientId        String
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Float         @default(0)
  tax             Float         @default(0)
  taxRate         Float         @default(0) // Tax rate as percentage
  discount        Float         @default(0)
  total           Float         @default(0)
  currency        String        @default("EUR") // Currency code (EUR, USD, GBP, etc.)
  notes           String?
  terms           String?
  paidAt          DateTime?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  items        InvoiceItem[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  projectId   String?
  taskId      String?
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================
// COMPANY SETTINGS (for Invoices)
// ============================================

model CompanySettings {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  companyName     String
  email           String?
  phone           String?
  website         String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  logo            String?
  taxId           String?
  defaultTaxRate  Float    @default(0)
  defaultCurrency String   @default("EUR") // Default currency for invoices
  defaultTerms    String?
  defaultNotes    String?
  invoicePrefix   String   @default("INV")
  nextInvoiceNumber Int    @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}
